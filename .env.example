# Copy this file to .env and replace the OAuth placeholders before starting
# Docker Compose. Never commit the populated .env file.

# UID/GID used by the read-only files-viewer container. Use the owner IDs of
# the mounted source directories on the host.
FILE_UID=1000
FILE_GID=1000

# Host directories exposed through the virtual projects and hermes roots.
PROJECTS_HOST_DIR=/path/to/projects
HERMES_HOST_DIR=/path/to/hermes

# OIDC application credentials for oauth2-proxy.
OIDC_ISSUER_URL=https://auth.example.com/application/o/files-viewer/
OIDC_REDIRECT_URL=https://files.example.com/oauth2/callback
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret

# Random 32-byte value used to encrypt the oauth2-proxy session cookie.
# Generate a fresh value for each deployment; do not reuse this example.
COOKIE_SECRET=replace-with-a-32-byte-cookie-secret
